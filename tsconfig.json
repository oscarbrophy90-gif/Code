{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@hoops/shared": ["./shared/src/index.ts"],
      "@hoops/shared/*": ["./shared/src/*"]
    }
  },
  "include": [
    "shared/src/**/*.ts",
    "shared/test/**/*.ts",
    "client/src/**/*.ts",
    "server/src/**/*.ts",
    "client/vite.config.ts",
    "betterme/src/**/*.ts",
    "betterme/test/**/*.ts",
    "betterme/vite.config.ts"
  ]
}
